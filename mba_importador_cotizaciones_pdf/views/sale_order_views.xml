<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_order_form_inherit_pdf_import" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.pdf.import</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="before">
                    <field name="has_import_warnings" invisible="1"/>
                    <div class="alert alert-warning mb-2" role="alert" invisible="not has_import_warnings">
                        <strong class="d-block">⚠️ Cotización Importada con Alertas de Homologación:</strong>
                        <field name="import_warning_message" readonly="1" class="d-block mt-1"/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='client_order_ref']" position="after">
                    <field name="imported_from_pdf" invisible="1"/>
                    <field name="origin_customer_name" readonly="1" invisible="not origin_customer_name"/>
                    <field name="legacy_quotation_number" readonly="1" invisible="not legacy_quotation_number"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
