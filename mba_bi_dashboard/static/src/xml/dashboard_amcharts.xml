<?xml version="1.0" encoding="utf-8"?>

<templates xml:space="preserve">
    <t t-name="mba_bi_dashboard.DashboardAmcharts">
        <section class="row container-fluid py-2 bg-view border-bottom border-top m-0 align-items-center" style="min-height: 48px;">
            <div class="left-panel col-md-6 d-flex gap-2 align-items-center">
                <h4 class="mb-0 me-3"><strong t-out="state.name"></strong></h4>
                <button t-if="!state.editMode &amp;&amp; state.charts.length" class="btn btn-sm btn-secondary" title="Imprimir Tablero (PDF)" t-on-click="onPrintDashboard">
                    <i class="fa fa-print me-1" /> Imprimir
                </button>
                <button t-if="!state.editMode &amp;&amp; state.charts.length" class="btn btn-sm btn-secondary" title="Exportar Configuración JSON" t-on-click="export_json">
                    <i class="fa fa-download" />
                </button>
                <input type="file" accept=".json" t-ref="fileInput" style="display:none" t-on-change="onFileChange"/>
                <button t-if="!state.editMode &amp;&amp; !state.charts.length" class="btn btn-sm btn-secondary" type="button" title="Importar Configuración JSON" t-on-click="onUploadClick">
                    <i class="fa fa-upload me-1" /> Importar JSON
                </button>
                <button t-if="!state.editMode &amp;&amp; state.charts.length &amp;&amp; !dashboard_user" class="btn btn-sm btn-secondary" title="Enviar por Correo" t-on-click="onSendEmail">
                    <i class="fa fa-envelope" />
                </button>
                <button class="btn btn-sm btn-secondary" t-if="state.editMode" t-on-click="onEditDiscard" title="Descartar Cambios">
                    <i class="fa fa-close me-1" /> Descartar
                </button>
                <button class="btn btn-sm btn-secondary" t-if="state.charts.length &amp;&amp; !dashboard_user" t-on-click="onEditLayout" title="Modificar Diseño / Mover Elementos">
                    <t t-if="state.editMode">
                        <i class="fa fa-floppy-o me-1" /> Guardar Diseño
                    </t>
                    <t t-else="">
                        <i class="fa fa-pencil me-1" /> Editar Diseño
                    </t>
                </button>
            </div>
            <div class="right-panel col-md-6 d-flex justify-content-end gap-2">
                <button t-if="!state.editMode &amp;&amp; !dashboard_user" class="btn btn-sm btn-primary" t-on-click="onAddLayout">
                    <i class="fa fa-plus me-1" /> Agregar Gráfico / KPI
                </button>
            </div>
        </section>
        <main style="height: calc(100vh - 110px); padding: 8px 12px; overflow: auto;">
            <div style="overflow: auto; max-height: 98%;">
                <div class="grid-stack m-1" gs-w="36">
                    <t t-foreach="state.charts" t-as="chart" t-key="chart.id">
                        <div class="grid-stack-item m-1" t-att-data-chart-id="chart.id" t-att-gs-w="chart.w" t-att-gs-h="chart.h" t-att-gs-min-h="chart.minh" t-att-gs-x="chart.x" t-att-gs-y="chart.y">
                            <DashboardChartWrapper editChart="editChart" theme="chart.theme" onUpdateExport="onUpdateExport" reloadKey="reloadKey.value" chart_type="chart.chart_type" chartId="chart.id" name="chart.name" recordSets="chart.recordset" background_color="chart.background_color" dashboard_user="dashboard_user"/>
                        </div>
                    </t>
                </div>
            </div>
        </main>
    </t>
</templates>
