<?xml version="1.0" encoding="utf-8"?>

<templates xml:space="preserve">
    <t t-name="mba_bi_dashboard.TodoView">
        <div t-if="this.state.isError" class="w-100 d-flex align-items-center justify-content-center" style="height: 90%;">
            <h5 t-out="this.state.errorMessage"></h5>
        </div>
        <div t-if="!this.state.isError" style="height: 92%;">
            <div t-if="state.layout_type == 'default'" class="o_mba_bi_dashboard_todo_preview h-100">
                <div class="list-navigation">
                    <t t-foreach="state.data.map((record, index) => ({ ...record, __index: index }))" t-as="record" t-key="record.__index">
                        <button t-attf-class="#{record.id == state.activeSelectedRecord ? 'list-btn active' : 'list-btn'}" t-on-click="(ev) => setChildElements(ev, record, record.action_line_ids)"><t t-out="record.name" /></button>
                    </t>
                </div>
                <div class="todo-header">
                    <h4 class="todo-title" id="listTitle"><t t-out="state.currentTask" /></h4>
                    <div class="todo-stats">
                        <span id="completed-count"><t t-out="state.completedTasks" /></span> de <span id="total-count"><t t-out="state.totalTasks" /></span> completadas
                    </div>
                </div>

                <ul class="todo-list" id="todoList">
                    <t t-foreach="state.lines.map((line, index) => ({ ...line, __index: index }))" t-as="line" t-key="line.__index">
                        <li t-attf-class="#{line.active_record ? 'todo-item completed': 'todo-item'}">
                            <span class="todo-text"><t t-out="line.name" /></span>
                        </li>
                    </t>
                </ul>

            </div>
            <div t-if="state.layout_type == 'activity'" style="overflow: auto; height: 92%;">
                <div t-foreach="state.data.map((record, index) => ({ ...record, __index: index }))" t-as="record" t-key="record.__index" class="row m-0 p-2 border-bottom">
                    <div class="col-4 d-flex align-items-center justify-content-center" style="font-size: 13px; font-weight: 500;">
                        <span t-out="record.date" />
                    </div>
                    <div class="col-8" style="font-size: 12px;">
                        <div><strong>Actividad:</strong> <span t-out="record.activity_type" /></div>
                        <div><strong>Título:</strong> <span t-out="record.name" /></div>
                        <div><strong>Responsable:</strong> <span t-out="record.username" /></div>
                        <div t-if="record.summary"><strong>Resumen:</strong> <span t-out="record.summary" /></div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
