        <field name="data_type">sum</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('state', '=', 'posted'), ('payment_state', 'in', ('not_paid', 'partial'))]</field>
        <field name="layout_type">layout1</field>
        <field name="background_color">#6f42c1</field>
        <field name="font_color">#ffffff</field>
        <field name="icon_option">default</field>
        <field name="default_icon">credit-card</field>
    </record>

    <!-- Gráfico 1: Top Clientes con Saldo Pendiente -->
    <record id="chart_top_cartera_clientes" model="dashboard.chart">
        <field name="name">Top Clientes con Saldo por Cobrar</field>
        <field name="dashboard_id" ref="dashboard_panama_cxc"/>
        <field name="chart_type">bar_chart</field>
        <field name="model_id" ref="account.model_account_move"/>
