    <record id="kpi_inventario_operativo_proyectado" model="dashboard.chart">
        <field name="name">Inv. Operativo Proyectado</field>
        <field name="dashboard_id" ref="dashboard_panama_inventario"/>
        <field name="chart_type">kpi</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="data_type">sum</field>
        <field name="domain">[('location_id.usage', '=', 'internal')]</field>
        <field name="layout_type">layout1</field>
        <field name="background_color">#71639e</field>
        <field name="font_color">#ffffff</field>
        <field name="icon_option">default</field>
        <field name="default_icon">bullseye</field>
    </record>

    <!-- Gráfico 1: Movimientos por Tipo de Almacén -->
    <record id="chart_movimientos_tipo" model="dashboard.chart">
        <field name="name">Operaciones por Tipo de Almacén</field>
        <field name="dashboard_id" ref="dashboard_panama_inventario"/>
        <field name="chart_type">column_chart</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="group_by_id" ref="stock.field_stock_picking__picking_type_id"/>
        <field name="data_type">count</field>
        <field name="theme">animated</field>
    </record>

    <!-- Gráfico 2: Distribución por Estado -->
    <record id="chart_estado_operaciones" model="dashboard.chart">
        <field name="name">Distribución por Estado de Operación</field>
        <field name="dashboard_id" ref="dashboard_panama_inventario"/>
        <field name="chart_type">pie_chart</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="group_by_id" ref="stock.field_stock_picking__state"/>
        <field name="data_type">count</field>
        <field name="theme">animated</field>
    </record>

    <function name="create_update_menu" model="dashboard.dashboard">
        <value eval="[ref('dashboard_panama_inventario')]" />
    </function>

</odoo>
