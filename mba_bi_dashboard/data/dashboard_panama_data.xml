        <field name="dashboard_id" ref="dashboard_panama_ventas"/>
        <field name="chart_type">kpi</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="measurement_field_ids" eval="[(4, ref('sale.field_sale_order__amount_total'))]"/>
