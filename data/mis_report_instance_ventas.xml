<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">

    <record id="instance_estado_resultados_ventas" model="mis.report.instance">
        <field name="name">Estado de Resultados de Ventas - Mensual</field>
        <field name="report_id" ref="report_ventas" />
        <field name="comparison_mode" eval="True" />
    </record>
    <record id="instance_erv_mes_anterior" model="mis.report.instance.period">
        <field name="name">Mes Anterior</field>
        <field name="report_instance_id" ref="instance_estado_resultados_ventas" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-1</field>
        <field name="sequence">10</field>
    </record>
    <record id="instance_erv_mes_actual" model="mis.report.instance.period">
        <field name="name">Mes Actual</field>
        <field name="report_instance_id" ref="instance_estado_resultados_ventas" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="sequence">20</field>
    </record>
    <record id="instance_erv_ytd" model="mis.report.instance.period">
        <field name="name">Acumulado del Año</field>
        <field name="report_instance_id" ref="instance_estado_resultados_ventas" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="is_ytd" eval="True" />
        <field name="sequence">30</field>
    </record>

</odoo>
