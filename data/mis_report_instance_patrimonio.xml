<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">

    <record id="instance_cambios_patrimonio" model="mis.report.instance">
        <field name="name">Estado de Cambios en el Patrimonio</field>
        <field name="report_id" ref="report_patrimonio" />
        <field name="comparison_mode" eval="True" />
    </record>
    <record id="instance_cp_ano_anterior" model="mis.report.instance.period">
        <field name="name">Año Anterior (Cerrado)</field>
        <field name="report_instance_id" ref="instance_cambios_patrimonio" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">y</field>
        <field name="offset">-1</field>
        <field name="sequence">10</field>
    </record>
    <record id="instance_cp_ano_actual" model="mis.report.instance.period">
        <field name="name">Año Actual (Acumulado)</field>
        <field name="report_instance_id" ref="instance_cambios_patrimonio" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="is_ytd" eval="True" />
        <field name="sequence">20</field>
    </record>

</odoo>
