<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_custom" inherit_id="purchase.report_purchaseorder_document" priority="30">

        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-call">web.basic_layout</attribute>
        </xpath>

        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address"/>
        </xpath>

        <xpath expr="//div[@class='page']" position="replace">
            <div class="page" style="font-family: Arial, sans-serif; font-size: 10pt; color: black;">
                <style>
                    .header div[name="company_address"] {
                        display: none !important;
                    }
                </style>

                <div class="mb-5" style="margin-bottom: 40px !important;">
                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 80px; width: auto;" alt="Logo"/>
                </div>

                <div class="row mb-4">
                    <div class="col-6">
                        <strong style="font-size: 16pt; margin-bottom: 2px; display: block;">Proveedor: <span t-field="o.partner_id.name"/></strong>
                        <hr style="border-top: 2px solid black; opacity: 1; margin-top: 0px; margin-bottom: 10px;"/>
                        <strong>Contacto:</strong> <span t-field="o.partner_id.child_ids[0].name" t-if="o.partner_id.child_ids"/><br/>
                        <strong>Dirección:</strong> <span t-field="o.partner_id.street"/><br/>
                        <t t-if="o.partner_id.phone">
                            <strong>Teléfono:</strong> <span t-field="o.partner_id.phone"/><br/>
                        </t>
                        <t t-if="o.partner_id.email">
                            <strong>Correo:</strong> <span t-field="o.partner_id.email"/><br/>
                        </t>
                    </div>

                    <div class="col-5 offset-1">
                        <strong style="font-size: 16pt; margin-bottom: 2px; display: block;">Orden de Compra: <span t-field="o.name"/></strong>
                        <hr style="border-top: 2px solid black; opacity: 1; margin-top: 0px; margin-bottom: 10px;"/>
                        <strong>Fecha del Pedido:</strong> <span t-field="o.date_order" t-options='{"widget": "date"}'/><br/>
                        <strong>Fecha Prevista:</strong> <span t-field="o.date_planned" t-options='{"widget": "date"}'/><br/>
                        <strong>Condiciones de pago:</strong> <span t-field="o.payment_term_id.name"/>
                    </div>
                </div>

                <div t-if="o.partner_ref" class="mt-3 mb-2">
                    <strong style="font-size: 11pt;">Ref. del Proveedor: <span t-field="o.partner_ref"/></strong>
                </div>

                <table class="mt-2" style="width: 100%; border-collapse: collapse;">
                    <thead style="display: table-header-group;">
                        <tr style="background-color: #04167e; color: white !important; font-weight: bold; border-bottom: 3px solid #cb1a1c;">
                            <th class="text-start" style="padding: 8px; border: none; color: white !important;">Referencia</th>
                            <th class="text-start" style="padding: 8px; border: none; color: white !important;">Descripción</th>
                            <th class="text-center" style="padding: 8px; border: none; color: white !important;">Cantidad</th>
                            <th class="text-end" style="padding: 8px; border: none; color: white !important;">Precio</th>
                            <th class="text-center" style="padding: 8px; border: none; color: white !important;">Impuesto</th>
                            <th class="text-end" style="padding: 8px; border: none; color: white !important;">Importe</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.order_line" t-as="line">
                            <tr t-if="not line.display_type" style="border-bottom: 1px solid #e0e0e0; page-break-inside: avoid;">
                                <td class="text-start" style="padding: 4px; vertical-align: middle;"><span t-esc="line.product_id.default_code"/></td>
                                <td class="text-start" style="padding: 4px; vertical-align: middle;"><span t-esc="line.name.replace('[%s] ' % line.product_id.default_code, '', 1) if line.product_id.default_code else line.name"/></td>
                                <td class="text-center" style="padding: 4px; vertical-align: middle;"><span t-esc="int(line.product_qty)"/></td>
                                <td class="text-end" style="padding: 4px; vertical-align: middle;"><t t-esc="o.currency_id.symbol"/> <span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-center" style="padding: 4px; vertical-align: middle;"><t t-esc="o.currency_id.symbol"/> <span t-field="line.price_tax" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-end" style="padding: 4px; vertical-align: middle;"><t t-esc="o.currency_id.symbol"/> <span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                            <tr t-elif="line.display_type == 'line_section'" style="background-color: #f2f2f2;">
                                <td colspan="6" class="text-start" style="padding: 8px;">
                                    <strong style="font-size: 11pt;"><span t-field="line.name"/></strong>
                                </td>
                            </tr>
                            <tr t-elif="line.display_type == 'line_note'">
                                <td colspan="6" class="text-start" style="padding: 8px; font-style: italic;">
                                    <span t-field="line.name"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <div class="row justify-content-end mt-3" style="page-break-inside: avoid;">
                    <div class="col-5">
                        <table style="width: 100%;">
                            <tr>
                                <td class="text-start"><strong>Subtotal</strong></td>
                                <td class="text-end"><t t-esc="o.currency_id.symbol"/> <span t-field="o.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                            <t t-if="o.tax_totals">
                                <t t-foreach="o.tax_totals.get('subtotals', [])" t-as="subtotal">
                                    <t t-foreach="subtotal.get('tax_groups', [])" t-as="tax_group">
                                        <tr>
                                            <td class="text-start"><strong><t t-esc="tax_group['group_name']"/></strong></td>
                                            <td class="text-end"><t t-esc="o.currency_id.symbol"/> <t t-esc="'%.2f' % tax_group['tax_amount_currency']"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </t>
                            <tr style="background-color: #04167e; color: white; font-weight: bold; border-top: 3px solid #cb1a1c;">
                                <td class="text-start" style="padding: 8px; color: white !important;">TOTAL</td>
                                <td class="text-end" style="padding: 8px; color: white !important;"><t t-esc="o.currency_id.symbol"/> <span t-field="o.amount_total" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="mt-2" t-if="o.notes" style="font-size: 9pt;">
                    <strong style="display: block; margin-bottom: 3px;">Notas:</strong>
                    <span t-field="o.notes"/>
                </div>

            </div>
        </xpath>
    </template>
</odoo>
