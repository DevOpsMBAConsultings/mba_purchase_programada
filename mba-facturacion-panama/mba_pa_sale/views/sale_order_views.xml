<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    <record id="view_order_form_inherit_dgi_payment_term" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.dgi.payment.term</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="options">{'no_open': True}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_dgi_notes" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.dgi.notes</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <group string="Datos FE (DGI)" name="group_dgi_notes">
                    <field name="dgi_payment_notes"
                           readonly="1"
                           placeholder="Notas complementarias (se copiarán a la factura, máx. 200 caracteres en DGI)..."
                           nolabel="0"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_dgi_no_quick_create" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.dgi.no.quick.create</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="options">{'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_template_id']" position="attributes">
                <attribute name="options">{'no_quick_create': True}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_dgi_direct_invoice" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.dgi.direct.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Overrides primary "Create Invoice" button -->
            <xpath expr="//button[@id='create_invoice']" position="attributes">
                <attribute name="name">action_create_invoice_direct</attribute>
                <attribute name="type">object</attribute>
                <attribute name="groups">mba_pa_edi.group_digifact_user</attribute>
            </xpath>
            <!-- Overrides secondary "Create Invoice" button (percentage/advance) -->
            <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
                <attribute name="name">action_create_invoice_direct</attribute>
                <attribute name="type">object</attribute>
                <attribute name="groups">mba_pa_edi.group_digifact_user</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_order_form_inherit_dgi_readonly_taxes" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.dgi.readonly.taxes</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='tax_id']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <xpath expr="//field[@name='validity_date']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>
    </data>
</odoo>
