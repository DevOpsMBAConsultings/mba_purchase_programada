<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dashboard_dashboard_tree_view" model="ir.ui.view">
        <field name="name">dashboard.dashboard.tree.view</field>
        <field name="model">dashboard.dashboard</field>
        <field name="arch" type="xml">
            <list duplicate="0">
                <field name="menu_sequence" widget="handle"/>
                <field name="name" string="Nombre del Tablero"/>
                <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                <button name="action_view_charts" type="object" string="Ver Gráficos" icon="fa-area-chart"/>
            </list>
        </field>
    </record>

    <record id="dashboard_dashboard_form_view" model="ir.ui.view">
        <field name="name">dashboard.dashboard.form.view</field>
        <field name="model">dashboard.dashboard</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header>
                    <button name="create_update_menu" type="object" string="Crear / Actualizar Menú" invisible="created_menu_id" class="btn-primary"/>
                    <button name="action_delete_menu" type="object" string="Eliminar Menú" invisible="not created_menu_id" class="btn-secondary"/>
                    <button name="%(action_dashboard_access)d" type="action" string="Gestionar Acceso" groups="mba_bi_dashboard.group_dashboard_manager"/>
                    <button name="action_dashboard_send" invisible="1" id="send_by_email_dashboard" string="Enviar por Correo" type="object" class="btn-primary" context="{'validate_analytic': True, 'check_document_layout': True}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_charts"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-th"
                            invisible="chart_count == 0">
                            <field name="chart_count" widget="statinfo" string="Gráficos / KPIs"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" string="Nombre del Tablero" placeholder="Ej. Tablero Ejecutivo Panamá..."/>
                            <field name="menu_sequence" invisible="1" />
                            <field name="mail_cron_id" invisible="1"/>
                            <field name="access_by" string="Tipo de Acceso" invisible="not access_by" readonly="1" />
                            <field name="group_ids" string="Grupos con Acceso" readonly="1" widget="many2many_tags" invisible="access_by != 'access_group'" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="user_ids" string="Usuarios con Acceso" readonly="1" widget="many2many_tags" invisible="access_by != 'user'" domain="[('share', '=', False)]" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="parent_menu_id" string="Menú Superior" context="{'ir.ui.menu.full_list': True}" />
                            <field name="menu_active" widget="boolean_toggle" invisible="1" />
                            <field name="created_menu_id" invisible="1" />
                            <field name="created_action_id" invisible="1" />
                            <field name="company_id" string="Compañía" options="{'no_create': True}" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Actualización Automática" name="auto_update">
                            <group>
                                <group>
                                    <field name="auto_reload_duration" string="Intervalo de Refresco" required="1" />
                                </group>
                            </group>
                        </page>
                        <page string="Envío Programado por Correo" name="email_schedule">
                            <field name="dashboard_mail_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="dashboard_id" column_invisible="1" />
                                    <field name="name" string="Descripción"/>
                                    <field name="mail_template_id" string="Plantilla de Correo" required="1" />
                                    <field name="is_automated" string="Automático"/>
                                    <field name="chart_ids" string="Gráficos a Incluir" invisible="not mail_template_id" required="mail_template_id" domain="[('dashboard_id', '=', dashboard_id), '|', ('chart_type', '!=', 'to_do'), ('todo_layout', '!=', 'default')]" widget="many2many_tags" options="{'no_create': 1}" context="{'is_automated': is_automated}" />
                                    <field name="recipient_ids" string="Destinatarios" widget="many2many_tags" invisible="not mail_template_id" required="mail_template_id" domain="[('type', '!=', 'private')]" options="{'no_create': 1}" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dashboard_filter" model="ir.ui.view">
        <field name="name">dashboard.dashboard.search</field>
        <field name="model">dashboard.dashboard</field>
        <field name="arch" type="xml">
            <search string="Buscar Tableros">
                <field name="name" string="Nombre"/>
                <field name="access_by" string="Acceso Por"/>
                <field name="user_ids" string="Usuarios"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Tipo de Acceso" name="access_by" domain="[]" context="{'group_by': 'access_by'}"/>
                    <filter string="Compañía" name="company_id" domain="[]" context="{'group_by': 'company_id'}" groups="!base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dashboard_dashboard_action" model="ir.actions.act_window">
        <field name="name">Tableros</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dashboard.dashboard</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer Tablero de Inteligencia de Negocios
            </p>
            <p>
                Diseña cuadros de mando visuales con KPIs en tiempo real y gráficos interactivos para Panamá.
            </p>
        </field>
    </record>

    <!-- Menús Principales del Módulo -->
    <menuitem id="parent_dashboard_menu" name="Tableros BI" web_icon="mba_bi_dashboard,static/description/icon.png" sequence="10" />
    <menuitem id="dashboard_configuration_menu" parent="parent_dashboard_menu" name="Configuración" groups="mba_bi_dashboard.group_dashboard_manager" sequence="100" />
    <menuitem id="dashboard_dashboard_menu" name="Gestión de Tableros" parent="dashboard_configuration_menu" action="dashboard_dashboard_action" sequence="10" />

</odoo>
