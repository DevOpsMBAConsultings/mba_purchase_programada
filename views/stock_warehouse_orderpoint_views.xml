<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia en la vista list/tree editable de Reabastecimiento -->
    <record id="view_warehouse_orderpoint_tree_editable_inherit_mb_vendor" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.tree.editable.inherit.mb.vendor</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="allowed_vendor_ids" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='vendor_id']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_vendor_ids)]</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Herencia en la vista formulario de Reabastecimiento -->
    <record id="view_warehouse_orderpoint_form_inherit_mb_vendor" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.form.inherit.mb.vendor</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="allowed_vendor_ids" invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='vendor_id']" position="attributes">
                <attribute name="domain">[('id', 'in', allowed_vendor_ids)]</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
