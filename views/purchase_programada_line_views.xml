<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulario del wizard de compras programadas:
         - Ancho ultra espacioso (96vw / 92vh)
         - Scroll contenido en o_list_renderer para garantizar cabecera fija
         - Cabecera fija (Sticky thead th) que se mantiene arriba al hacer scroll
         - Agrega solo productos con cantidad > 0 -->
    <record id="view_purchase_programada_wizard_form" model="ir.ui.view">
        <field name="name">mba.purchase.programada.wizard.form</field>
        <field name="model">mba.purchase.programada.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccionar productos del proveedor" class="o_purchase_programada_wizard_form">
                <style>
                    /* 1. Modal ancho y alto */
                    .modal:has(.o_purchase_programada_wizard_form) .modal-dialog {
                        max-width: 96vw !important;
                        width: 96vw !important;
                        margin: 1rem auto !important;
                    }
                    .modal:has(.o_purchase_programada_wizard_form) .modal-content {
                        max-height: 92vh !important;
                        height: 92vh !important;
                    }
                    .modal:has(.o_purchase_programada_wizard_form) .modal-body {
                        padding: 0 !important;
                        overflow: hidden !important;
                    }
                    .o_purchase_programada_wizard_form {
                        height: 100% !important;
                    }
                    .o_purchase_programada_wizard_form .o_form_renderer {
                        max-width: 100% !important;
                        height: 100% !important;
                    }
                    .o_purchase_programada_wizard_form .o_field_x2many {
                        height: 100% !important;
                    }

                    /* 2. El contenedor que hace scroll con altura acotada */
                    .o_purchase_programada_wizard_form .o_list_renderer {
                        max-height: calc(92vh - 120px) !important;
                        overflow-y: auto !important;
                        overflow-x: auto !important;
                    }

                    /* 3. Sticky Header 100% efectivo */
                    .o_purchase_programada_wizard_form .o_list_table thead {
                        position: sticky !important;
                        top: 0 !important;
                        z-index: 100 !important;
                    }
                    .o_purchase_programada_wizard_form .o_list_table thead th {
                        position: sticky !important;
                        top: 0 !important;
                        z-index: 100 !important;
                        background-color: #f1f3f5 !important;
                        border-bottom: 2px solid #ced4da !important;
                        box-shadow: inset 0 -2px 0 #ced4da;
                    }
                </style>
                <field name="order_id" invisible="1"/>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false" limit="1000">
                        <field name="mba_reference" string="Referencia" readonly="1"/>
                        <field name="product_id" string="Descripción" readonly="1"
                                context="{'display_default_code': False}"/>
                        <field name="qty_to_order" string="Cantidad a pedir"/>
                        <field name="price_unit" string="Precio unitario"/>
                        <field name="mba_qty_on_hand" string="A la mano" readonly="1"/>
                        <field name="mba_sold_m1"
                               string="M(-1)"
                               help="Unidades vendidas el mes anterior (más reciente)"
                               optional="show"
                               readonly="1"/>
                        <field name="mba_sold_m2"
                               string="M(-2)"
                               help="Unidades vendidas hace 2 meses"
                               optional="show"
                               readonly="1"/>
                        <field name="mba_sold_m3"
                               string="M(-3)"
                               help="Unidades vendidas hace 3 meses"
                               optional="show"
                               readonly="1"/>
                        <field name="mba_sold_m4"
                               string="M(-4)"
                               help="Unidades vendidas hace 4 meses (mes más antiguo)"
                               optional="show"
                               readonly="1"/>
                        <field name="mba_sold_total_4m"
                               string="Total 4M"
                               help="Total de unidades vendidas en los últimos 4 meses"
                               optional="show"
                               readonly="1"/>
                        <field name="subtotal" string="Subtotal"
                               help="Cantidad x Precio unitario. Si el proveedor dio un precio especial por el lote, escríbelo aquí directamente y el Precio unitario se recalcula solo."/>
                    </list>
                </field>
                <footer>
                    <button name="action_add_to_order" type="object"
                            string="Agregar productos" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
