<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Formulario del wizard: la lista de productos va embebida en un
         campo one2many (line_ids), no como acción de lista suelta -así
         no aparecen checkboxes de selección (esos son propios de las
         vistas de lista de nivel superior, no de un x2many dentro de un
         formulario)-. El botón "Agregar productos" va en el <footer>,
         que siempre está disponible sin depender de ninguna selección:
         revisa todas las filas y agrega solo las que tengan Cantidad a
         pedir > 0 (ver PurchaseProgramadaWizard.action_add_to_order). -->
    <record id="view_purchase_programada_wizard_form" model="ir.ui.view">
        <field name="name">mba.purchase.programada.wizard.form</field>
        <field name="model">mba.purchase.programada.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccionar productos del proveedor" class="o_purchase_programada_wizard_form">
                <field name="order_id" invisible="1"/>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="mba_reference" string="Referencia" readonly="1"/>
                        <field name="product_id" string="Descripción" readonly="1"
                               context="{'display_default_code': False}"/>
                        <field name="qty_to_order" string="Cantidad a pedir"/>
                        <field name="price_unit" string="Precio unitario"/>
                        <field name="mba_qty_on_hand" string="A la mano" readonly="1"/>
                        <field name="mba_sold_m1"
                               string="M(-1)"
                               help="Unidades vendidas el mes anterior (más reciente)"
                               optional="show"
                               readonly="1"/>
                        <field name="mba_sold_m2"
                               string="M(-2)"
                               help="Unidades vendidas hace 2 meses"
                               optional="show"
                               readonly="1"/>
                        <field name="mba_sold_m3"
                               string="M(-3)"
                               help="Unidades vendidas hace 3 meses"
                               optional="show"
                               readonly="1"/>
                        <field name="mba_sold_m4"
                               string="M(-4)"
                               help="Unidades vendidas hace 4 meses (mes más antiguo)"
                               optional="show"
                               readonly="1"/>
                        <field name="mba_sold_total_4m"
                               string="Total 4M"
                               help="Total de unidades vendidas en los últimos 4 meses"
                               optional="show"
                               readonly="1"/>
                        <field name="subtotal" string="Subtotal"
                               help="Cantidad x Precio unitario. Si el proveedor dio un precio especial por el lote, escríbelo aquí directamente y el Precio unitario se recalcula solo."/>
                    </list>
                </field>
                <footer>
                    <button name="action_add_to_order" type="object"
                            string="Agregar productos" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
