<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_aging_analysis_pivot" model="ir.ui.view">
        <field name="name">account.aging.analysis.pivot</field>
        <field name="model">account.aging.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Aged Balance" sample="1">
                <field name="aging_bucket" type="col"/>
                <field name="commercial_partner_id" type="row"/>
                <field name="amount_residual" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_account_aging_analysis_graph" model="ir.ui.view">
        <field name="name">account.aging.analysis.graph</field>
        <field name="model">account.aging.analysis</field>
        <field name="arch" type="xml">
            <graph string="Aged Balance" type="pie" sample="1">
                <field name="aging_bucket"/>
                <field name="amount_residual" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_account_aging_analysis_list" model="ir.ui.view">
        <field name="name">account.aging.analysis.list</field>
        <field name="model">account.aging.analysis</field>
        <field name="arch" type="xml">
            <list string="Aged Balance" create="0" sample="1">
                <field name="move_name"/>
                <field name="ref" optional="hide"/>
                <field name="partner_id"/>
                <field name="date" optional="hide"/>
                <field name="date_maturity"/>
                <field name="days_overdue"/>
                <field name="aging_bucket"/>
                <field name="invoice_user_id" optional="hide"/>
                <field name="journal_id" optional="hide"/>
                <field name="amount_residual" sum="Amount Due"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_account_aging_analysis_search" model="ir.ui.view">
        <field name="name">account.aging.analysis.search</field>
        <field name="model">account.aging.analysis</field>
        <field name="arch" type="xml">
            <search string="Aged Balance">
                <field name="partner_id"/>
                <field name="move_name"/>
                <field name="account_id"/>
                <field name="invoice_user_id"/>
                <filter name="f_receivable" string="Receivable"
                        domain="[('ledger','=','receivable')]"/>
                <filter name="f_payable" string="Payable"
                        domain="[('ledger','=','payable')]"/>
                <separator/>
                <filter name="f_overdue" string="Overdue"
                        domain="[('aging_bucket','!=','not_due')]"/>
                <filter name="f_not_due" string="Not due"
                        domain="[('aging_bucket','=','not_due')]"/>
                <separator/>
                <filter name="f_bucket_1" string="First bucket"
                        domain="[('aging_bucket','=','bucket_1')]"/>
                <filter name="f_bucket_2" string="Second bucket"
                        domain="[('aging_bucket','=','bucket_2')]"/>
                <filter name="f_bucket_3" string="Third bucket"
                        domain="[('aging_bucket','=','bucket_3')]"/>
                <filter name="f_bucket_4" string="Oldest bucket"
                        domain="[('aging_bucket','=','bucket_4')]"/>
                <group expand="1" string="Group By">
                    <filter name="g_bucket" string="Ageing Bucket"
                            context="{'group_by': 'aging_bucket'}"/>
                    <filter name="g_partner" string="Commercial Entity"
                            context="{'group_by': 'commercial_partner_id'}"/>
                    <filter name="g_ledger" string="Ledger"
                            context="{'group_by': 'ledger'}"/>
                    <filter name="g_user" string="Salesperson"
                            context="{'group_by': 'invoice_user_id'}"/>
                    <filter name="g_maturity" string="Due Date"
                            context="{'group_by': 'date_maturity'}"/>
                    <filter name="g_journal" string="Journal"
                            context="{'group_by': 'journal_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_account_aging_receivable" model="ir.actions.act_window">
        <field name="name">Aged Receivable</field>
        <field name="res_model">account.aging.analysis</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('ledger', '=', 'receivable')]</field>
        <field name="context">{'search_default_g_bucket': 1}</field>
        <field name="search_view_id" ref="view_account_aging_analysis_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No outstanding customer balances
            </p>
            <p>
                Open customer items, classified by how many days they are past
                their due date.
            </p>
        </field>
    </record>

    <record id="action_account_aging_payable" model="ir.actions.act_window">
        <field name="name">Aged Payable</field>
        <field name="res_model">account.aging.analysis</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('ledger', '=', 'payable')]</field>
        <field name="context">{'search_default_g_bucket': 1}</field>
        <field name="search_view_id" ref="view_account_aging_analysis_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No outstanding vendor balances
            </p>
            <p>
                Open vendor items, classified by how many days they are past
                their due date.
            </p>
        </field>
    </record>

    <menuitem id="menu_account_aging_receivable"
              name="Aged Receivable"
              parent="account.menu_finance_reports"
              action="action_account_aging_receivable"
              sequence="21"/>

    <menuitem id="menu_account_aging_payable"
              name="Aged Payable"
              parent="account.menu_finance_reports"
              action="action_account_aging_payable"
              sequence="22"/>

</odoo>
