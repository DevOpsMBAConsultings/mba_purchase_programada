<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_mb_sale_availability" model="ir.ui.view">
        <field name="name">sale.order.form.mb.sale.availability</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom']" position="before">
                <field name="free_qty_available" string="Stock Disp." optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
