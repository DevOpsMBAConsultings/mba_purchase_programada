<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_aging" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.aging</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!--
                Anchored on the Accounting app container rather than on a
                specific block. Block ids change between Odoo releases and any
                other installed module can add, rename or reorder them; the app
                element is the one part of this view that stays put.
            -->
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Antigüedad de Saldos" id="account_aging_analysis">
                    <setting string="Tramos de antigüedad"
                             help="Umbrales en días vencidos para clasificar los apuntes abiertos de clientes y proveedores.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="account_aging_bucket_1" string="Primer tramo hasta"
                                       class="col-lg-5 o_light_label"/>
                                <field name="account_aging_bucket_1" class="oe_inline"/>
                                <span class="oe_inline ms-1">días</span>
                            </div>
                            <div class="row">
                                <label for="account_aging_bucket_2" string="Segundo tramo hasta"
                                       class="col-lg-5 o_light_label"/>
                                <field name="account_aging_bucket_2" class="oe_inline"/>
                                <span class="oe_inline ms-1">días</span>
                            </div>
                            <div class="row">
                                <label for="account_aging_bucket_3" string="Tercer tramo hasta"
                                       class="col-lg-5 o_light_label"/>
                                <field name="account_aging_bucket_3" class="oe_inline"/>
                                <span class="oe_inline ms-1">días</span>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
