<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Multi-company visibility.

        This rule is intentionally global (no groups assigned): company
        isolation must apply to every user, including accounting managers.
        Assigning it to a group would leave users outside that group able to
        read balances from companies they are not allowed to see.

        `company_ids` (plural) is used on purpose so that a user with several
        allowed companies keeps seeing all of them.
    -->
    <record id="rule_account_aging_analysis_company" model="ir.rule">
        <field name="name">Aged Balance Analysis: multi-company</field>
        <field name="model_id" ref="model_account_aging_analysis"/>
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
