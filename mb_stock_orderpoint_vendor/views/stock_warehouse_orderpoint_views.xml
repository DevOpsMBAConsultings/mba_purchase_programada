<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Herencia 1: opciones del campo proveedor -->
    <record id="view_warehouse_orderpoint_tree_editable_inherit_mb_vendor" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.tree.editable.inherit.mb.vendor</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='supplier_id']" position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Herencia 2: separar Referencia / Descripción en la columna de producto (MBA Consultings) -->
    <record id="view_warehouse_orderpoint_tree_editable_inherit_mb_reference" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.tree.editable.inherit.mb.reference</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <!--
                Ancla semántica: field[@name='product_id'] — campo estable y único en la vista core.
                Se inserta la Referencia (product_id.default_code, campo relacionado propio,
                ver models/stock_warehouse_orderpoint.py) antes del producto, y se le quita el
                prefijo "[REF]" al campo product_id mediante el context display_default_code=False
                (clave estándar de Odoo, no un hack), para que solo muestre la descripción.
            -->
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="mba_reference"
                       string="Referencia"
                       optional="show"
                       readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="string">Descripción</attribute>
                <attribute name="context">{'default_is_storable': True, 'display_default_code': False}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Herencia 3: columnas de historial de ventas (MBA Consultings) -->
    <record id="view_warehouse_orderpoint_tree_editable_inherit_mb_sales_history" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.tree.editable.inherit.mb.sales.history</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <!--
                Ancla semántica: field[@name='qty_on_hand'] — campo estable y único en la vista core.
                Las columnas de ventas se insertan inmediatamente después del stock disponible.
            -->
            <xpath expr="//field[@name='qty_on_hand']" position="after">
                <field name="mba_sold_m1"
                       string="M(-1)"
                       help="Unidades vendidas el mes anterior (más reciente)"
                       optional="show"
                       readonly="1"/>
                <field name="mba_sold_m2"
                       string="M(-2)"
                       help="Unidades vendidas hace 2 meses"
                       optional="show"
                       readonly="1"/>
                <field name="mba_sold_m3"
                       string="M(-3)"
                       help="Unidades vendidas hace 3 meses"
                       optional="show"
                       readonly="1"/>
                <field name="mba_sold_m4"
                       string="M(-4)"
                       help="Unidades vendidas hace 4 meses (mes más antiguo)"
                       optional="show"
                       readonly="1"/>
                <field name="mba_sold_total_4m"
                       string="Total 4M"
                       help="Total de unidades vendidas en los últimos 4 meses"
                       optional="show"
                       readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>

