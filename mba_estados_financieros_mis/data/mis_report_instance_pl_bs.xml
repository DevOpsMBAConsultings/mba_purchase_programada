<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">

    <!-- ═══ Estado de Resultados - instancia mensual ═══ -->
    <record id="instance_estado_resultados" model="mis.report.instance">
        <field name="name">Estado de Resultados - Mensual</field>
        <field name="report_id" ref="mis_template_financial_report.report_pl" />
        <field name="comparison_mode" eval="True" />
    </record>
    <record id="instance_er_mes_anterior" model="mis.report.instance.period">
        <field name="name">Mes Anterior</field>
        <field name="report_instance_id" ref="instance_estado_resultados" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-1</field>
        <field name="sequence">10</field>
    </record>
    <record id="instance_er_mes_actual" model="mis.report.instance.period">
        <field name="name">Mes Actual</field>
        <field name="report_instance_id" ref="instance_estado_resultados" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="sequence">20</field>
    </record>
    <record id="instance_er_ytd" model="mis.report.instance.period">
        <field name="name">Acumulado del Año</field>
        <field name="report_instance_id" ref="instance_estado_resultados" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="is_ytd" eval="True" />
        <field name="sequence">30</field>
    </record>

    <!-- ═══ Balance General - instancia mensual ═══ -->
    <record id="instance_balance_general" model="mis.report.instance">
        <field name="name">Balance General - Mensual</field>
        <field name="report_id" ref="mis_template_financial_report.report_bs" />
        <field name="comparison_mode" eval="True" />
    </record>
    <record id="instance_bg_mes_anterior" model="mis.report.instance.period">
        <field name="name">Cierre Mes Anterior</field>
        <field name="report_instance_id" ref="instance_balance_general" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-1</field>
        <field name="sequence">10</field>
    </record>
    <record id="instance_bg_mes_actual" model="mis.report.instance.period">
        <field name="name">A la Fecha</field>
        <field name="report_instance_id" ref="instance_balance_general" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="sequence">20</field>
    </record>
    <record id="instance_bg_ano_anterior" model="mis.report.instance.period">
        <field name="name">Cierre Año Anterior</field>
        <field name="report_instance_id" ref="instance_balance_general" />
        <field name="source">actuals</field>
        <field name="mode">relative</field>
        <field name="type">y</field>
        <field name="offset">-1</field>
        <field name="sequence">30</field>
    </record>

</odoo>
