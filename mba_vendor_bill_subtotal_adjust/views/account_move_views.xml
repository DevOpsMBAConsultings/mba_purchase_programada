<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_vendor_subtotal_adjust" model="ir.ui.view">
        <field name="name">account.move.form.inherit.vendor.subtotal.adjust</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="attributes">
                <attribute name="readonly">state != 'draft' or parent.move_type not in ('in_invoice', 'in_refund')</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
