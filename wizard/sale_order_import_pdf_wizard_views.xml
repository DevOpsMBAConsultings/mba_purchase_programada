<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sale_order_import_pdf_wizard_form" model="ir.ui.view">
            <field name="name">sale.order.import.pdf.wizard.form</field>
            <field name="model">sale.order.import.pdf.wizard</field>
            <field name="arch" type="xml">
                <form string="Importar Cotizaciones en PDF">
                    <div class="alert alert-info mb-3" role="alert">
                        <strong>📄 Importación de Documentos PDF:</strong><br/>
                        Seleccione uno o varios archivos PDF de cotizaciones para crearlos en estado borrador.
                        Los clientes no registrados se asignarán a <em>Consumidor Final</em> y los artículos no encontrados se importarán con alerta para revisión del vendedor.
                    </div>
                    <group>
                        <field name="attachment_ids" widget="many2many_binary" string="Archivos PDF" nolabel="0"/>
                    </group>
                    <footer>
                        <button name="action_import_pdf" string="Importar Cotizaciones" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sale_order_import_pdf_wizard" model="ir.actions.act_window">
            <field name="name">Importar Cotizaciones PDF</field>
            <field name="res_model">sale.order.import.pdf.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">list,form</field>
        </record>

        <menuitem id="menu_sale_order_import_pdf"
                  name="Importar Cotizaciones PDF"
                  parent="sale.sale_order_menu"
                  action="action_sale_order_import_pdf_wizard"
                  sequence="20"/>
    </data>
</odoo>
