<odoo>

    <!-- Wizard Form View -->
    <record id="view_purchase_merge_automatic_wizard_form" model="ir.ui.view">
        <field name="name">purchase.merge.automatic.wizard.form</field>
        <field name="model">purchase.merge.automatic.wizard</field>
        <field name="arch" type="xml">
            <form string="Consolidate Purchase Orders">
                <group>
                    <group>
                        <field name="purchase_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <group>
                        <field name="dst_purchase_id"/>
                    </group>
                </group>

                <separator string="Options"/>
                <group>
                    <field name="delete_source_po"/>
                </group>

                <footer>
                    <button name="action_merge" string="Consolidate" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard from PO tree view -->
    <record id="action_purchase_merge_automatic_wizard" model="ir.actions.act_window">
        <field name="name">Consolidate Purchase Orders</field>
        <field name="res_model">purchase.merge.automatic.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">action</field>
    </record>

</odoo>
